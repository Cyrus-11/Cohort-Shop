# Safe for browser code
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never prefix these with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Optional for applying migrations with psql; never used by browser code.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:5432/postgres
APP_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=
PAYSTACK_MODE=test
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Must include a name before the @, e.g. Cohort Shop <postmaster@your-domain>
MAILGUN_FROM=
MAILGUN_API_URL=https://api.mailgun.net
